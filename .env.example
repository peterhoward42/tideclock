# Copy to `.env` for local dev and build. `.env` is gitignored.
#
# Tide proxy origin (no trailing slash). The client requests `${VITE_TIDE_PROXY_BASE_URL}/v1/tides`.
# See https://github.com/peterhoward42/tideproxy — deploy your own instance or use an existing one.
VITE_TIDE_PROXY_BASE_URL=https://your-tide-proxy.example.com

# Telemetry ingest origin (no trailing slash). The client POSTs `${VITE_TELEMETRY_BASE_URL}/v1/events`.
VITE_TELEMETRY_BASE_URL=https://your-telemetry-ingest.example.com
